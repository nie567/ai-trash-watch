# 数据库配置模板 —— 复制为 db.properties 后填入真实密码
# db.properties 已加入 .gitignore，不会提交到仓库
# 也可用 -Ddb.password=xxx 或 DB_PASSWORD 环境变量注入（优先级：系统属性 > 环境变量 > 文件）
db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/AI-TrashWatch?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf8&allowPublicKeyRetrieval=true
db.username=root
db.password=YOUR_PASSWORD_HERE
